# PostgreSQL Database Connection (Neon or local)
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/aquabestbrands

# Payload CMS Secret (change to a strong random string in production)
PAYLOAD_SECRET=your-secret-key-change-in-production

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload Public Server URL
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# --- Optional: SMTP / Email (if omitted, Payload logs emails to console) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM_ADDRESS=noreply@aquabestbrands.com
# SMTP_FROM_NAME=AquaBest Brands
