# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.pub

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# payload
/media
/generated-schema.graphql

# build helpers
# (empty-module.cjs / empty-module.css are intentionally committed — required by webpack build)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling / stray files (not part of the project)
/pnpm-lock.yaml
/pnpm-workspace.yaml
/shipments-transcript-part.txt